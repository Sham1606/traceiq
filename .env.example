# TRACEIQ Environment Configuration
# PostgreSQL Database Connection URL
DATABASE_URL=postgresql+psycopg://traceiq:change_me@localhost:5432/traceiq

# Dedicated PostgreSQL Test Database URL (used for test isolation)
TEST_DATABASE_URL=postgresql+psycopg://traceiq:change_me@localhost:5432/traceiq_test

# Evidence Engine Data Root (defaults to data/generated)
DATA_ROOT=data/generated

# AI Orchestration
AI_ENABLED=true
AI_PROVIDER=mock
AI_MODEL=mock-reasoner

# Debug Mode
DEBUG=false
